-- إنشاء جدول المرضى
CREATE TABLE IF NOT EXISTS Patients (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    age INTEGER NOT NULL,
    condition TEXT NOT NULL,
    notes TEXT
);

